<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="0dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <!-- Pending Confirmation -->
        <include
            android:id="@+id/status_pending_confirmation"
            layout="@layout/item_order_status"
            android:layout_width="0dp"
            android:layout_height="77dp"
            android:layout_weight="1" />

        <!-- Pending Pickup -->
        <include
            android:id="@+id/status_pending_pickup"
            layout="@layout/item_order_status"
            android:layout_width="0dp"
            android:layout_height="77dp"
            android:layout_weight="1" />

        <!-- Shipping -->
        <include
            android:id="@+id/status_shipping"
            layout="@layout/item_order_status"
            android:layout_width="0dp"
            android:layout_height="77dp"
            android:layout_weight="1" />

        <!-- Review -->
        <include
            android:id="@+id/status_review"
            layout="@layout/item_order_status"
            android:layout_width="0dp"
            android:layout_height="77dp"
            android:layout_weight="1" />

        <!-- Return/Refund (if needed, can be placed here or removed) -->
        <!-- <include
            android:id="@+id/status_return_refund"
            layout="@layout/item_order_status"
            android:layout_width="0dp"
            android:layout_height="77dp"
            android:layout_weight="1" /> -->

    </LinearLayout>

</androidx.cardview.widget.CardView>
