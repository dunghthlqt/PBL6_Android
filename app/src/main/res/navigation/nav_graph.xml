<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/landingPageFragment">

    <fragment
        android:id="@+id/landingPageFragment"
        android:name="com.demo.pbl6_android.ui.landing.LandingPageFragment"
        android:label="Landing Page">
        <action
            android:id="@+id/action_landingPageFragment_to_accountFragment"
            app:destination="@id/accountFragment" />
        <action
            android:id="@+id/action_landingPageFragment_to_productDetailFragment"
            app:destination="@id/productDetailFragment" />
        <action
            android:id="@+id/action_landingPageFragment_to_categoriesFragment"
            app:destination="@id/categoriesFragment" />
        <action
            android:id="@+id/action_landingPageFragment_to_shopFragment"
            app:destination="@id/shopFragment" />
        <action
            android:id="@+id/action_landingPageFragment_to_searchInputFragment"
            app:destination="@id/searchInputFragment" />
    </fragment>
    
    <!-- Search Fragments -->
    <fragment
        android:id="@+id/searchInputFragment"
        android:name="com.demo.pbl6_android.ui.search.SearchInputFragment"
        android:label="Tìm kiếm">
        <action
            android:id="@+id/action_searchInputFragment_to_searchResultsFragment"
            app:destination="@id/searchResultsFragment" />
    </fragment>
    
    <fragment
        android:id="@+id/searchResultsFragment"
        android:name="com.demo.pbl6_android.ui.search.SearchResultsFragment"
        android:label="Kết quả tìm kiếm">
        <argument
            android:name="searchQuery"
            app:argType="string" />
        <action
            android:id="@+id/action_searchResultsFragment_to_productDetailFragment"
            app:destination="@id/productDetailFragment" />
    </fragment>
    
    <fragment
        android:id="@+id/productDetailFragment"
        android:name="com.demo.pbl6_android.ui.product.ProductDetailFragment"
        android:label="Product Detail">
        <argument
            android:name="productId"
            app:argType="string" />
        <action
            android:id="@+id/action_productDetailFragment_to_cartFragment"
            app:destination="@id/cartFragment" />
        <action
            android:id="@+id/action_productDetailFragment_to_orderFragment"
            app:destination="@id/orderFragment" />
        <action
            android:id="@+id/action_productDetailFragment_to_chatFragment"
            app:destination="@id/chatFragment" />
        <action
            android:id="@+id/action_productDetailFragment_to_shopFragment"
            app:destination="@id/shopFragment" />
        <action
            android:id="@+id/action_productDetailFragment_to_productReviewsFragment"
            app:destination="@id/productReviewsFragment" />
    </fragment>
    
    <!-- Product Reviews Fragment -->
    <fragment
        android:id="@+id/productReviewsFragment"
        android:name="com.demo.pbl6_android.ui.review.ProductReviewsFragment"
        android:label="Đánh giá sản phẩm">
        <argument
            android:name="productId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/accountFragment"
        android:name="com.demo.pbl6_android.ui.account.AccountFragment"
        android:label="Account">
        <action
            android:id="@+id/action_accountFragment_to_landingPageFragment"
            app:destination="@id/landingPageFragment" />
        <action
            android:id="@+id/action_accountFragment_to_orderHistoryFragment"
            app:destination="@id/orderHistoryFragment" />
        <action
            android:id="@+id/action_accountFragment_to_userInformationFragment"
            app:destination="@id/userInformationFragment" />
        <action
            android:id="@+id/action_accountFragment_to_shippingAddressFragment"
            app:destination="@id/shippingAddressFragment" />
        <action
            android:id="@+id/action_accountFragment_to_paymentMethodsFragment"
            app:destination="@id/paymentMethodsFragment" />
        <action
            android:id="@+id/action_accountFragment_to_sellerHomeFragment"
            app:destination="@id/sellerHomeFragment" />
    </fragment>
    
    <fragment
        android:id="@+id/userInformationFragment"
        android:name="com.demo.pbl6_android.ui.account.UserInformationFragment"
        android:label="User Information" />
    
    <fragment
        android:id="@+id/shippingAddressFragment"
        android:name="com.demo.pbl6_android.ui.address.ShippingAddressFragment"
        android:label="Shipping Address" />
    
    <fragment
        android:id="@+id/paymentMethodsFragment"
        android:name="com.demo.pbl6_android.ui.payment.PaymentMethodsFragment"
        android:label="Payment Methods" />
    
    <fragment
        android:id="@+id/orderHistoryFragment"
        android:name="com.demo.pbl6_android.ui.order.OrderHistoryFragment"
        android:label="Order History">
        <argument
            android:name="initialTab"
            android:defaultValue="0"
            app:argType="integer" />
        <action
            android:id="@+id/action_orderHistoryFragment_to_orderDetailFragment"
            app:destination="@id/orderDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/cartFragment"
        android:name="com.demo.pbl6_android.ui.cart.CartFragment"
        android:label="Cart">
        <action
            android:id="@+id/action_cartFragment_to_orderFragment"
            app:destination="@id/orderFragment" />
        <action
            android:id="@+id/action_cartFragment_to_shopFragment"
            app:destination="@id/shopFragment" />
    </fragment>

    <fragment
        android:id="@+id/orderFragment"
        android:name="com.demo.pbl6_android.ui.order.OrderFragment"
        android:label="Order">
        <action
            android:id="@+id/action_orderFragment_to_shopVoucherFragment"
            app:destination="@id/shopVoucherFragment" />
        <action
            android:id="@+id/action_orderFragment_to_platformVoucherFragment"
            app:destination="@id/platformVoucherFragment" />
        <action
            android:id="@+id/action_orderFragment_to_shippingMethodFragment"
            app:destination="@id/shippingMethodFragment" />
        <action
            android:id="@+id/action_orderFragment_to_addressSelectionFragment"
            app:destination="@id/addressSelectionFragment" />
        <action
            android:id="@+id/action_orderFragment_to_orderStatusFragment"
            app:destination="@id/orderStatusFragment" />
    </fragment>
    
    <fragment
        android:id="@+id/addressSelectionFragment"
        android:name="com.demo.pbl6_android.ui.address.AddressSelectionFragment"
        android:label="Address Selection">
        <action
            android:id="@+id/action_addressSelectionFragment_to_addressFormFragment"
            app:destination="@id/addressFormFragment" />
    </fragment>
    
    <fragment
        android:id="@+id/addressFormFragment"
        android:name="com.demo.pbl6_android.ui.address.AddressFormFragment"
        android:label="Address Form">
        <argument
            android:name="addressId"
            app:argType="string"
            app:nullable="true" />
    </fragment>
    
    <fragment
        android:id="@+id/orderStatusFragment"
        android:name="com.demo.pbl6_android.ui.order.OrderStatusFragment"
        android:label="Order Status">
        <argument
            android:name="paymentMethod"
            app:argType="string" />
        <argument
            android:name="orderId"
            app:argType="string" />
        <action
            android:id="@+id/action_orderStatusFragment_to_orderHistoryFragment"
            app:destination="@id/orderHistoryFragment" />
    </fragment>

    <fragment
        android:id="@+id/shopVoucherFragment"
        android:name="com.demo.pbl6_android.ui.voucher.ShopVoucherFragment"
        android:label="Shop Voucher" />

    <fragment
        android:id="@+id/platformVoucherFragment"
        android:name="com.demo.pbl6_android.ui.voucher.PlatformVoucherFragment"
        android:label="Platform Voucher" />

    <fragment
        android:id="@+id/shippingMethodFragment"
        android:name="com.demo.pbl6_android.ui.shipping.ShippingMethodFragment"
        android:label="Shipping Method" />

    <fragment
        android:id="@+id/orderDetailFragment"
        android:name="com.demo.pbl6_android.ui.order.OrderDetailFragment"
        android:label="Order Detail">
        <argument
            android:name="orderId"
            app:argType="string" />
        <action
            android:id="@+id/action_orderDetailFragment_to_productDetailFragment"
            app:destination="@id/productDetailFragment" />
        <action
            android:id="@+id/action_orderDetailFragment_to_chatFragment"
            app:destination="@id/chatFragment" />
        <action
            android:id="@+id/action_orderDetailFragment_to_shopFragment"
            app:destination="@id/shopFragment" />
    </fragment>

    <!-- Message/Chat Fragments -->
    <fragment
        android:id="@+id/messageListFragment"
        android:name="com.demo.pbl6_android.ui.chat.MessageListFragment"
        android:label="Messages">
        <action
            android:id="@+id/action_messageListFragment_to_chatFragment"
            app:destination="@id/chatFragment" />
    </fragment>

    <fragment
        android:id="@+id/chatFragment"
        android:name="com.demo.pbl6_android.ui.chat.ChatFragment"
        android:label="Chat">
        <argument
            android:name="conversationId"
            app:argType="string" />
        <action
            android:id="@+id/action_chatFragment_to_shopFragment"
            app:destination="@id/shopFragment" />
    </fragment>

    <!-- Notification Fragment -->
    <fragment
        android:id="@+id/notificationFragment"
        android:name="com.demo.pbl6_android.ui.notification.NotificationFragment"
        android:label="Thông báo">
        <action
            android:id="@+id/action_notificationFragment_to_cartFragment"
            app:destination="@id/cartFragment" />
        <action
            android:id="@+id/action_notificationFragment_to_messageListFragment"
            app:destination="@id/messageListFragment" />
    </fragment>

    <!-- Categories Fragments -->
    <fragment
        android:id="@+id/categoriesFragment"
        android:name="com.demo.pbl6_android.ui.categories.CategoriesFragment"
        android:label="Categories">
        <action
            android:id="@+id/action_categoriesFragment_to_categoryProductsFragment"
            app:destination="@id/categoryProductsFragment" />
        <action
            android:id="@+id/action_categoriesFragment_to_productDetailFragment"
            app:destination="@id/productDetailFragment" />
        <action
            android:id="@+id/action_categoriesFragment_to_cartFragment"
            app:destination="@id/cartFragment" />
        <action
            android:id="@+id/action_categoriesFragment_to_shopFragment"
            app:destination="@id/shopFragment" />
    </fragment>

    <fragment
        android:id="@+id/categoryProductsFragment"
        android:name="com.demo.pbl6_android.ui.categories.CategoryProductsFragment"
        android:label="Category Products">
        <argument
            android:name="categoryId"
            app:argType="string" />
        <argument
            android:name="categoryName"
            app:argType="string" />
        <action
            android:id="@+id/action_categoryProductsFragment_to_productDetailFragment"
            app:destination="@id/productDetailFragment" />
        <action
            android:id="@+id/action_categoryProductsFragment_to_cartFragment"
            app:destination="@id/cartFragment" />
        <action
            android:id="@+id/action_categoryProductsFragment_to_shopFragment"
            app:destination="@id/shopFragment" />
    </fragment>

    <!-- Shop Fragment -->
    <fragment
        android:id="@+id/shopFragment"
        android:name="com.demo.pbl6_android.ui.shop.ShopFragment"
        android:label="Shop">
        <argument
            android:name="shopName"
            app:argType="string"
            app:nullable="true" />
        <action
            android:id="@+id/action_shopFragment_to_productDetailFragment"
            app:destination="@id/productDetailFragment" />
        <action
            android:id="@+id/action_shopFragment_to_chatFragment"
            app:destination="@id/chatFragment" />
    </fragment>

    <!-- Seller Fragments -->
    <fragment
        android:id="@+id/sellerHomeFragment"
        android:name="com.demo.pbl6_android.ui.seller.SellerHomeFragment"
        android:label="Shop của tôi">
        <action
            android:id="@+id/action_sellerHomeFragment_to_sellerOrderHistoryFragment"
            app:destination="@id/sellerOrderHistoryFragment" />
        <action
            android:id="@+id/action_sellerHomeFragment_to_sellerProductsFragment"
            app:destination="@id/sellerProductsFragment" />
        <action
            android:id="@+id/action_sellerHomeFragment_to_sellerFinanceFragment"
            app:destination="@id/sellerFinanceFragment" />
        <action
            android:id="@+id/action_sellerHomeFragment_to_sellerSalesFragment"
            app:destination="@id/sellerSalesFragment" />
    </fragment>
    
    <fragment
        android:id="@+id/sellerProductsFragment"
        android:name="com.demo.pbl6_android.ui.seller.SellerProductsFragment"
        android:label="Sản Phẩm của Tôi" />
    
    <fragment
        android:id="@+id/sellerFinanceFragment"
        android:name="com.demo.pbl6_android.ui.seller.SellerFinanceFragment"
        android:label="Tài chính" />
    
    <fragment
        android:id="@+id/sellerSalesFragment"
        android:name="com.demo.pbl6_android.ui.seller.SellerSalesFragment"
        android:label="Hiệu quả bán hàng" />
    
    <fragment
        android:id="@+id/sellerAccountFragment"
        android:name="com.demo.pbl6_android.ui.seller.SellerAccountFragment"
        android:label="Tài khoản Seller" />
    
    <fragment
        android:id="@+id/sellerOrderHistoryFragment"
        android:name="com.demo.pbl6_android.ui.seller.SellerOrderHistoryFragment"
        android:label="Đơn Hàng">
        <action
            android:id="@+id/action_sellerOrderHistoryFragment_to_sellerOrderDetailFragment"
            app:destination="@id/sellerOrderDetailFragment" />
        <action
            android:id="@+id/action_sellerOrderHistoryFragment_to_sellerCancelledOrderDetailFragment"
            app:destination="@id/sellerCancelledOrderDetailFragment" />
    </fragment>
    
    <fragment
        android:id="@+id/sellerOrderDetailFragment"
        android:name="com.demo.pbl6_android.ui.seller.SellerOrderDetailFragment"
        android:label="Chi tiết đơn hàng" />
    
    <fragment
        android:id="@+id/sellerCancelledOrderDetailFragment"
        android:name="com.demo.pbl6_android.ui.seller.SellerCancelledOrderDetailFragment"
        android:label="Chi tiết đơn hàng" />

</navigation>
